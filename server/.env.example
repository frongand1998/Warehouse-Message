# Server Configuration
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/warehouse-message

# Facebook Messenger API
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token_here
FACEBOOK_PAGE_ID=your_page_id_here
RECIPIENT_ID=your_recipient_psid_here

# Webhook Verification Token (create a random string)
WEBHOOK_VERIFY_TOKEN=my_webhook_token_123

# For production, you'll need to:
# 1. Create a Facebook App at https://developers.facebook.com/
# 2. Add Messenger product to your app
# 3. Generate a Page Access Token
# 4. Get the recipient PSID (Page-Scoped ID) of the user you want to send messages to
